# ============================================================================
# AI Content Factory — configuração. Copie para .env e ajuste:  cp .env.example .env
# Variáveis marcadas com [OBRIGATÓRIO] precisam ser definidas antes de subir.
# ============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_ENV=production
# [OBRIGATÓRIO] chave longa e aleatória:  openssl rand -hex 32
SECRET_KEY=
# [OBRIGATÓRIO] chave Fernet para criptografar credenciais no banco:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRETS_ENCRYPTION_KEY=
# Endereço público. Com domínio: SITE_ADDRESS=fabrica.seudominio.com (HTTPS automático)
SITE_ADDRESS=:80
PUBLIC_BASE_URL=http://localhost
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost
LOG_LEVEL=INFO

# [OBRIGATÓRIO] primeiro administrador (criado só se não existir nenhum usuário)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=

# --- Banco, fila e armazenamento ----------------------------------------------
POSTGRES_USER=factory
POSTGRES_DB=factory
# [OBRIGATÓRIO]
POSTGRES_PASSWORD=
S3_ACCESS_KEY=factory
# [OBRIGATÓRIO] chave secreta do armazenamento S3 interno (SeaweedFS)
S3_SECRET_KEY=
S3_BUCKET=content-factory
# URL pública do armazenamento (necessária para publicar Reels via API do Instagram):
# FILES_ADDRESS=files.seudominio.com
# S3_PUBLIC_ENDPOINT_URL=https://files.seudominio.com
WORKER_CONCURRENCY=2
BACKUP_RETENTION_DAYS=14

# Permite provedores simulados (gerador de modelos) para testar sem chaves.
ALLOW_SIMULATED_PROVIDERS=true

# --- Provedores de IA (opcional: também podem ser cadastrados na interface) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Ollama local, ex.: http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# --- Tendências ---------------------------------------------------------------
# YouTube Data API v3 (vídeos em alta). Console Google Cloud → APIs → YouTube Data API v3 → chave
YOUTUBE_API_KEY=

# --- Publicação (OAuth das plataformas) --------------------------------------
# Redirect URI a cadastrar em cada app:  {PUBLIC_BASE_URL}/api/oauth/<youtube|tiktok|instagram>/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
